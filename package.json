{
	"name": "anephenix-ui",
	"private": true,
	"description": "Monorepo for Anephenix UI: framework component packages, shared design tokens, and the docs site",
	"type": "module",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "npm run build --workspace=apps/docs",
		"build-lib": "npm run build --workspace=packages/react",
		"build-svelte": "npm run build --workspace=packages/svelte",
		"cover": "npm run cover --workspace=packages/react",
		"dev": "npm run dev --workspace=apps/docs",
		"format": "npx @biomejs/biome check . --write",
		"lint": "npx @biomejs/biome check .",
		"lint:package": "npm run lint:package --workspaces --if-present",
		"start": "npm run start --workspace=apps/docs",
		"prepare-patch-release": "npm run prepare-patch-release --workspace=packages/react",
		"publish-patch-release": "npm run publish-patch-release --workspace=packages/react",
		"test": "npm run test --workspaces --if-present",
		"size": "npm run size --workspaces --if-present",
		"compute-clips": "npm run compute-clips --workspace=apps/docs",
		"screenshots": "npm run screenshots --workspace=apps/docs",
		"update-changelog": "npm run update-changelog --workspace=packages/react",
		"prepare": "husky",
		"generate-types": "npm run generate-types --workspace=apps/docs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anephenix/ui.git"
	},
	"author": "Paul Jensen <paul@anephenix.com>",
	"maintainers": [
		{
			"name": "Paul Jensen",
			"email": "paul@anephenix.com"
		}
	],
	"license": "MIT",
	"husky": {
		"hooks": {
			"pre-commit": "npm run lint && npm t"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.11",
		"@size-limit/esbuild": "^13.0.1",
		"@size-limit/esbuild-why": "^13.0.1",
		"@size-limit/preset-small-lib": "^13.0.2",
		"globals": "^17.12.0",
		"husky": "^9.1.7"
	},
	"overrides": {
		"vite": "^8",
		"undici@^7.28.0": "^7.29.0"
	},
	"allowScripts": {
		"esbuild@0.28.1": true,
		"fsevents@2.3.3": true,
		"puppeteer@25.4.0": true,
		"workerd@1.20260730.1": true
	}
}
