{
	"name": "@anephenix/ui",
	"version": "0.4.4",
	"description": "A collection of UI components for React web applications",
	"type": "module",
	"main": "dist/index.js",
	"files": [
		"dist",
		"COMPONENTS.md"
	],
	"scripts": {
		"build": "node build.js",
		"cover": "npx vitest run --coverage",
		"test": "npx vitest run --coverage",
		"size": "size-limit",
		"lint:package": "npx publint",
		"update-changelog": "node scripts/update-changelog.ts",
		"prepare-patch-release": "npm run build && npm run size && git add dist && npm run update-changelog && git add CHANGELOG.md && git commit -m \"Updated changelog\" && npm version patch",
		"publish-patch-release": "npm run prepare-patch-release && git push origin master && git push --tags"
	},
	"keywords": [
		"react",
		"ui"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/anephenix/ui.git",
		"directory": "packages/react"
	},
	"author": "Paul Jensen <paul@anephenix.com>",
	"maintainers": [
		{
			"name": "Paul Jensen",
			"email": "paul@anephenix.com"
		}
	],
	"license": "MIT",
	"size-limit": [
		{
			"path": "dist/index.js",
			"limit": "250 kB"
		},
		{
			"path": "dist/index.css",
			"limit": "10 kB"
		}
	],
	"devDependencies": {
		"@anephenix/rcg": "0.0.28",
		"@anephenix/ui-tokens": "*",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.1.0",
		"@testing-library/user-event": "^14.6.1",
		"@vitejs/plugin-react": "^6.0.3",
		"@vitest/coverage-v8": "^4.1.2",
		"esbuild": "^0.28.0",
		"identity-obj-proxy": "^3.0.0",
		"jsdoc": "^4.0.3",
		"jsdom": "^30.0.0",
		"publint": "^0.3.14",
		"react-test-renderer": "^19.0.0",
		"size-limit": "^13.0.1",
		"vitest": "^4.1.2"
	},
	"dependencies": {
		"clipboard-copy": "^4.0.1",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"react-syntax-highlighter": "^16.1.1"
	}
}
