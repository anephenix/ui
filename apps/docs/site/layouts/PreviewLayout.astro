---
import "@anephenix/ui/dist/index.css";

const { theme, embed } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme={theme}>
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Component Preview</title>
        <style>
            *,
            *::before,
            *::after {
                box-sizing: border-box;
            }
            body {
                margin: 0;
                padding: 32px;
                background: var(--light);
                color: var(--dark);
                font-family:
                    "Helvetica Neue",
                    -apple-system,
                    BlinkMacSystemFont,
                    "Segoe UI",
                    Roboto,
                    sans-serif;
                -webkit-font-smoothing: antialiased;
            }
            @media screen and (prefers-color-scheme: dark) {
                :root:not([data-theme="light"]) body {
                    background: var(--dark);
                    color: var(--light);
                }
            }
            :root[data-theme="dark"] body {
                background: var(--dark);
                color: var(--light);
            }
            .preview-center {
                display: flex;
                align-items: center;
                justify-content: center;
                min-height: 450px;
                height: 100vh;
                padding: 2rem;
            }
            .preview-padded {
                padding: 2rem;
                min-height: 450px;
            }
            .preview-bare {
                min-height: 450px;
            }
            /* Embedded in ComponentExample's Preview tab, sized to fit its
               content — the fixed-viewport heights above are only needed
               for the standalone /preview route used by screenshot tooling. */
            body[data-embed] .preview-center {
                min-height: 0;
                height: auto;
                padding: 24px;
            }
            body[data-embed] .preview-padded {
                min-height: 0;
                padding: 24px;
            }
            body[data-embed] .preview-bare {
                min-height: 0;
            }
        </style>
    </head>
    <body data-embed={embed ? "1" : undefined}>
        <slot />
    </body>
</html>
